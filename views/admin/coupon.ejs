<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TimeCraft - Coupons</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #161616; 
    }
    .font-logo {
      font-family: 'Pacifico', cursive;
    }
    
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #1f2937; }
    ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #6b7280; }

   
    .swal2-popup {
      background: #1c1c1c !important;
      color: #e0e0e0 !important;
    }
    .swal2-title {
      color: #ffffff !important;
    }
    .swal2-confirm, .swal2-cancel {
      border-radius: 6px !important;
    }
    .fade-out {
      opacity: 0;
      transition: opacity 0.5s ease-out;
    }
  </style>
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'custom-orange': '#ff7e5f',
            'custom-dark-1': '#161616',
            'custom-dark-2': '#333',
            'custom-dark-3': '#1C1C1C',
            'custom-gray': '#a5a5a5',
            'custom-light': '#eaeaea',
          }
        }
      }
    }
  </script>
</head>

<body>

  <main class="p-8">
    
    <header class="flex justify-between items-center mb-8">
      <h2 class="text-3xl font-bold text-white">Coupons</h2>
      <form class="flex gap-4 items-center" id="controls-form">
        <div class="relative w-[250px]">
          <i class="fas fa-search absolute left-[15px] top-1/2 -translate-y-1/2 text-custom-gray"></i>
          <input 
            type="text" 
            name="search"
            id="searchInput" placeholder="Search by code..." 
            class="w-full pl-[40px] pr-[15px] py-[10px] rounded-lg border border-custom-dark-2 bg-custom-dark-1 text-custom-light text-[0.9rem] focus:outline-none focus:ring-2 focus:ring-blue-500"
            value="<%= typeof search !== 'undefined' ? search : '' %>"
          />
        </div>
      </form>
    </header>

    <div class="bg-custom-dark-3 rounded-2xl shadow-xl p-6">
      <div class="overflow-x-auto">
        <table class="w-full min-w-max text-left">
          <thead>
            <tr class="border-b border-gray-700">
              <th class="p-4 font-medium text-gray-400">Sl.No</th>
              <th class="p-4 font-medium text-gray-400">Code</th>
              <th class="p-4 font-medium text-gray-400">Type</th>
              <th class="p-4 font-medium text-gray-400">Discount</th>
              <th class="p-4 font-medium text-gray-400">Min Purchase</th>
              <th class="p-4 font-medium text-gray-400">Expiry Date</th>
              <th class="p-4 font-medium text-gray-400">Status</th>
              <th class="p-4 font-medium text-gray-400">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700" id="tableBody">
            <% data.forEach((coupon, index) => { %>
              <tr id="couponRow-<%= coupon._id %>" class="hover:bg-gray-800 transition-all">
                <td class="p-4 text-white font-medium"><%= (currentPage - 1) * limit + index + 1 %></td>
                <td class="p-4 text-white font-medium uppercase"><%= coupon.code %></td>
                <td class="p-4 text-gray-300 capitalize"><%= coupon.discountType %></td>
                <td class="p-4 text-gray-300">
                  <%= coupon.discountType === 'percentage' ? coupon.discountAmount + '%' : '₹' + coupon.discountAmount %>
                </td>
                <td class="p-4 text-gray-300"><%= coupon.minPurchase ? '₹' + coupon.minPurchase : 'N/A' %></td>
                <td class="p-4 text-gray-300"><%= new Date(coupon.expiryDate).toLocaleDateString('en-IN', { day:'2-digit', month:'2-digit', year:'numeric' }) %></td>
                <td class="p-4">
                  <span class="status-badge px-3 py-1 rounded-full text-xs font-medium capitalize
                    <%= coupon.status === 'active' ? 'bg-green-800 text-green-200' : 'bg-red-800 text-red-200' %>">
                    <%= coupon.status %>
                  </span>
                </td>
                <td class="p-4 flex gap-2">
                  <button data-id="<%= coupon._id %>" class="edit-btn bg-blue-600 hover:bg-blue-700 text-white font-medium py-1 px-4 rounded-md transition-colors">Edit</button>
                  <button 
                    data-id="<%= coupon._id %>" 
                    data-status="<%= coupon.status %>"
                    class="toggle-status-btn text-white font-medium py-1 px-4 rounded-md transition-colors
                      <%= coupon.status === 'active' ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %>">
                    <%= coupon.status === 'active' ? 'Deactivate' : 'Activate' %>
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    
    <div class="mt-6">
      <a href="/admin/addcoupon" class="inline-block bg-transparent border border-white bg-black hover:bg-gray-700 text-white font-medium py-2 px-5 rounded-lg transition-colors">
       Add Coupon
      </a>
    </div>

    <div class="pagination flex gap-2 mt-6 justify-center" id="pagination">
      <% if (totalPages > 1) { %>
        <% const searchParam = typeof search !== 'undefined' && search ? `&search=${search}` : '' %>
        <% if (currentPage > 1) { %>
          <a href="/admin/coupon?page=<%= currentPage - 1 %><%= searchParam %>" class="no-underline text-custom-gray px-[14px] py-[8px] rounded-md bg-custom-dark-1 border border-custom-dark-2 text-[0.9rem] transition-all duration-300 hover:bg-custom-dark-2 hover:text-custom-light">Previous</a>
        <% } %>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/admin/coupon?page=<%= i %><%= searchParam %>" 
             class="no-underline px-[14px] py-[8px] rounded-md border text-[0.9rem] transition-all duration-300
                    <%= i === currentPage 
                      ? 'bg-custom-orange text-white border-custom-orange' 
                      : 'text-custom-gray bg-custom-dark-1 border-custom-dark-2 hover:bg-custom-dark-2 hover:text-custom-light' 
                    %>">
            <%= i %>
          </a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a href="/admin/coupon?page=<%= currentPage + 1 %><%= searchParam %>" class="no-underline text-custom-gray px-[14px] py-[8px] rounded-md bg-custom-dark-1 border border-custom-dark-2 text-[0.9rem] transition-all duration-300 hover:bg-custom-dark-2 hover:text-custom-light">Next</a>
        <% } %>
      <% } %>
    </div>
  </main>

  <script src="/js/admin/coupon.js"></script>

  <script>
    let currentPageLimit = <%= limit %>
  </script>
</body>
</html>