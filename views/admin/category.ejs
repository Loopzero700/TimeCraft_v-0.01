<link rel="stylesheet" href="/css/admin/category.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
    .swal2-popup { background: #1c1c1c !important; color: #e0e0e0 !important; }
    .swal2-title { color: #ffffff !important; }
    .swal2-confirm, .swal2-cancel { border-radius: 6px !important; }
    .pagination a { cursor: pointer; } 
</style>

<main>
    <div class="page-header">
        <h2>Category Management</h2>
        <div class="search-bar">
            <i class="fas fa-search"></i>
            <input 
                id="searchInput"
                type="text" 
                placeholder="Search by category name..." 
                value="<%= typeof search !== 'undefined' ? search : '' %>"
                onkeyup="fetchCategory()"
            >
            <a id="clear-search-btn" href="#" onclick="clearSearch(event)">
                <i class="fas fa-times"></i>
            </a>
        </div>
    </div>

    <div class="data-table">
        <div class="table-header">
            <div class="column-id">Sl.No</div>
            <div class="column-name">Name</div>
            <div class="column-status">Status</div>
            <div class="column-action">Action</div>
        </div>

        <div id="category-rows">
            <% if (cat && cat.length > 0) { %>
                <% cat.forEach((category, index) => { %>
                    <% const sequentialId = (currentPage - 1) * 5 + index + 1; %>
                    <% const isBlocked = category.status !== 'active'; %>

                    <div class="data-row">
                        <div class="column-id"><%= sequentialId %></div>
                        <div class="column-name"><%= category.name %></div>
                        <div class="column-status">
                            <span class="status <%= !isBlocked ? 'status-active' : 'status-inactive' %>">
                                <%= category.status %>
                            </span>
                        </div>
                        <div class="column-action">
                            <a class="btn-edit" href="/admin/categories/edit/<%= category._id %>">Edit</a>
                            <% if (isBlocked) { %>
                                <button onclick="confirmStatusChange('<%= category._id %>', true)" class="btn-unblock">Active</button>
                            <% } else { %>
                                <button onclick="confirmStatusChange('<%= category._id %>', false)" class="btn-block">Inactive</button>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-data">No categories found</div>
            <% } %>
        </div>
    </div>

    <div class="table-actions">
        <a class="btn-add" href="/admin/addCategory">Add new Category</a>
    </div>

   <div class="page-footer">
    <div class="pagination" id="pagination">
        <% if (totalPages > 1) { %>
            <% if (currentPage > 1) { %>
                <a href="#" onclick="changePage(<%= currentPage - 1 %>, event)">Previous</a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="#" onclick="changePage(<%= i %>, event)" class="<%= i === currentPage ? 'active' : '' %>">
                    <%= i %>
                </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="#" onclick="changePage(<%= currentPage + 1 %>, event)">Next</a>
            <% } %>
        <% } %>
    </div>
</div>
</main>

<script src="/js/admin/category.js"></script>

<script>
    let currentPage = <%= currentPage %>
    const limit = 5
</script>