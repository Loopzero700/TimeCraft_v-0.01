<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
    /* Your SweetAlert styles */
    .swal2-popup {
        background: #1c1c1c !important;
        color: #e0e0e0 !important;
    }
    .swal2-title {
        color: #ffffff !important;
    }
    .swal2-confirm, .swal2-cancel {
        border-radius: 6px !important;
    }
    .fade-out {
        opacity: 0;
        transition: opacity 0.5s ease-out;
    }
</style>

<script>
    // Your Tailwind config
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: {
                    'sans': ['Inter', 'sans-serif'],
                    'logo': ['Great Vibes', 'cursive'],
                },
                colors: {
                    'brand-dark': '#111111', 
                    'brand-bg': '#18181b',   
                    'brand-sidebar': '#1c1c1c',
                    'brand-input': '#2d2d2d',  
                    'brand-border': '#2d2d2d', 
                    'brand-text': '#f4f4f5',   
                    'brand-text-dim': '#a1a1aa',
                }
            }
        }
    }
</script>

<div class="flex h-full">
    <main class="flex-1 p-6 md:p-10 md:ml-5 h-full overflow-y-auto">
        <div class="w-full max-w-5xl mx-auto">
            <div class="bg-brand-dark rounded-2xl p-6 mb-8">
                <h2 class="text-xl font-semibold text-white">Edit Offer</h2>
            </div>

            <div class="bg-brand-dark rounded-2xl p-8">
                <form id="offerForm" method="POST">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                        
                        <div class="space-y-6">
                            <div>
                                <label for="offer-name" class="block text-sm font-medium text-brand-text-dim mb-2">Offer Name</label>
                                <input type="text" name="offer-name" id="offer-name" value="<%= offerData.offer_name %>" class="w-full bg-brand-input border border-brand-border text-brand-text rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter offer name" onblur="this.value = this.value.trim()">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-brand-text-dim mb-2">Start Date</label>
                                <input type="date" name="start-date" id="start-date" value="<%= offerData.start_date.toISOString().split('T')[0] %>" class="w-full bg-brand-input border border-brand-border text-brand-text rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" >
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-brand-text-dim mb-2">Expiry Date</label>
                                <input type="date" name="expiry-date" id="expiry-date" value="<%= offerData.expiry_date.toISOString().split('T')[0] %>" class="w-full bg-brand-input border border-brand-border text-brand-text rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" >
                            </div>
                        </div>

                        <div class="space-y-6">
                            <div>
                                <label for="offer-type" class="block text-sm font-medium text-brand-text-dim mb-2">Offer Type</label>
                                <select id="offer-type" name="offer-type" class="w-full bg-brand-input border border-brand-border text-brand-text rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="" disabled>Select Offer Type</option>
                                    <option value="Category" <%= (offerData.offer_for_type === 'Category') ? 'selected' : '' %>>Category</option>
                                    <option value="Product" <%= (offerData.offer_for_type === 'Product') ? 'selected' : '' %>>Product</option>
                                </select>
                            </div>

                            <div id="offer-product-container">
                                <label for="offer-for-product" class="block text-sm font-medium text-brand-text-dim mb-2">Select Product</label>
                                <select id="offer-for-product" name="offer-for" class="w-full bg-brand-input border border-brand-border text-brand-text rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="" disabled selected>Select</option>
                                    <% productData.forEach((data) => { %>
                                        <option value="<%= data._id %>" 
                                            <%= (offerData.offer_for_type === 'Product' && offerData.offer_for_id.toString() === data._id.toString()) ? 'selected' : '' %>>
                                            <%= data.name %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <div id="offer-category-container">
                                <label for="offer-for-category" class="block text-sm font-medium text-brand-text-dim mb-2">Select Category</label>
                                <select id="offer-for-category" name="offer-for" class="w-full bg-brand-input border border-brand-border text-brand-text rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option value="" disabled selected>Select</T></option>
                                    <% categoryData.forEach((data) => { %>
                                        <option value="<%= data._id %>" 
                                            <%= (offerData.offer_for_type === 'Category' && offerData.offer_for_id.toString() === data._id.toString()) ? 'selected' : '' %>>
                                            <%= data.name %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <div>
                                <label for="discount-percentage" class="block text-sm font-medium text-brand-text-dim mb-2">Discount Percentage</label>
                                <input type="number" name="discount-percentage" id="discount-percentage" value="<%= offerData.discount_percentage %>" class="w-full bg-brand-input border border-brand-border text-brand-text rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter percentage">
                            </div>
                        </div>

                        <div class="md:col-span-2">
                            <label for="offer-description" class="block text-sm font-medium text-brand-text-dim mb-2">Offer Description</label>
                            <textarea id="offer-description" name="offer-description" rows="3" class="w-full bg-brand-input border border-brand-border text-brand-text rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter description..."><%= offerData.description %></textarea>
                        </div>

                        <div class="md:col-span-2 flex justify-end mt-4">
                            <button type="submit" class="bg-white text-black font-semibold text-lg py-3 px-12 rounded-lg hover:bg-gray-200 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-brand-dark focus:ring-white">
                                Update Offer
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const initialOfferType = '<%= offerData.offer_for_type %>'
    const offerId = '<%= offerData._id %>'
</script>

<script src="/js/admin/editOffer.js"></script>