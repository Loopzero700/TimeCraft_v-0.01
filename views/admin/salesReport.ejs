    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .loader { border-top-color: #FF7F50; -webkit-animation: spinner 1.5s linear infinite; animation: spinner 1.5s linear infinite; }
        @keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>

<body class="bg-[#111111] text-white min-h-screen p-4 md:p-8">

    <div class="max-w-7xl mx-auto flex flex-col gap-8">

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <h2 class="text-3xl font-bold text-white tracking-tight">Sales Report</h2>
            
            <div class="flex flex-col sm:flex-row items-center gap-3">
                
                <div class="relative w-full sm:w-64">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 w-4 h-4"></i>
                    <input 
                        type="text" 
                        id="searchInput"
                        placeholder="Search Order ID..." 
                        class="w-full bg-[#1A1A1A] text-gray-200 pl-10 pr-4 py-2.5 rounded-lg text-sm border border-[#333] focus:outline-none focus:border-gray-500 placeholder-gray-600 transition-colors"
                    >
                </div>

                <div class="flex gap-2 w-full sm:w-auto">
                    <button onclick="downloadReport('excel')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2.5 bg-[#1A1A1A] text-green-500 hover:bg-[#252525] rounded-lg text-sm font-medium border border-[#333] transition-colors">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Excel</span>
                    </button>
                    <button onclick="downloadReport('pdf')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 px-4 py-2.5 bg-[#1A1A1A] text-red-500 hover:bg-[#252525] rounded-lg text-sm font-medium border border-[#333] transition-colors">
                        <i data-lucide="file-text" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">PDF</span>
                    </button>
                </div>

                <div class="relative w-full sm:w-auto">
                    <button id="filterBtn" class="flex items-center justify-center gap-2 w-full sm:w-auto px-4 py-2.5 bg-[#1A1A1A] text-gray-300 hover:bg-[#252525] rounded-lg text-sm font-medium transition-colors border border-[#333]">
                        <i data-lucide="filter" class="w-4 h-4"></i>
                        <span id="currentFilterLabel">All Time</span>
                    </button>
                    
                    <div id="filterMenu" class="hidden absolute right-0 mt-2 w-64 bg-[#1A1A1A] border border-[#333] rounded-xl shadow-xl p-4 z-50">
                        <h3 class="text-xs font-bold text-gray-500 uppercase mb-3">Date Range</h3>
                        <div class="space-y-2">
                            <button onclick="setFilter('All', this)" class="filter-option w-full text-left px-3 py-2 rounded-md text-sm bg-[#FF7F50] text-white">All Time</button>
                            <button onclick="setFilter('Daily', this)" class="filter-option w-full text-left px-3 py-2 rounded-md text-sm text-gray-400 hover:bg-[#252525]">Today</button>
                            <button onclick="setFilter('Weekly', this)" class="filter-option w-full text-left px-3 py-2 rounded-md text-sm text-gray-400 hover:bg-[#252525]">Last 7 Days</button>
                            <button onclick="setFilter('Yearly', this)" class="filter-option w-full text-left px-3 py-2 rounded-md text-sm text-gray-400 hover:bg-[#252525]">This Year</button>
                            <button onclick="toggleCustomDate()" class="w-full text-left px-3 py-2 rounded-md text-sm text-gray-400 hover:bg-[#252525]">Custom Range</button>
                        </div>
                        
                       <div id="customDateInputs" class="hidden mt-4 space-y-3 pt-3 border-t border-[#333]">
    
    <div>
        <label for="startDate" class="block text-xs font-medium text-gray-300 mb-1 ml-1">Starting Date</label>
        <input type="date" id="startDate" class="w-full bg-[#82817f] border border-[#333] rounded px-2 py-1.5 text-xs text-gray-300 focus:border-[#FF7F50] outline-none">
    </div>

    <div>
        <label for="endDate" class="block text-xs font-medium text-gray-300 mb-1 ml-1">Ending Date</label>
        <input type="date" id="endDate" class="w-full bg-[#82817f] border border-[#333] rounded px-2 py-1.5 text-xs text-gray-300 focus:border-[#FF7F50] outline-none">
    </div>

    <button onclick="applyCustomFilter()" class="w-full mt-2 bg-[#FF7F50] hover:bg-[#E06840] text-white text-xs font-bold py-2 rounded transition-colors">Apply</button>
</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-[#1A1A1A] p-6 rounded-xl border border-[#252525]">
                <p class="text-gray-500 text-xs uppercase font-bold tracking-wider mb-4">Overall Sales</p>
                <h3 id="statTotalOrders" class="text-2xl font-bold text-white">...</h3>
            </div>
            <div class="bg-[#1A1A1A] p-6 rounded-xl border border-[#252525]">
                <p class="text-gray-500 text-xs uppercase font-bold tracking-wider mb-4">Total Revenue</p>
                <h3 id="statTotalRevenue" class="text-2xl font-bold text-white">...</h3>
            </div>
            <div class="bg-[#1A1A1A] p-6 rounded-xl border border-[#252525]">
                <p class="text-gray-500 text-xs uppercase font-bold tracking-wider mb-4">Total Discount</p>
                <h3 id="statTotalDiscount" class="text-2xl font-bold text-white">...</h3>
            </div>
        </div>

        <div class="bg-[#1A1A1A] rounded-xl border border-[#252525] p-6 flex flex-col min-h-[500px]">
            <div class="overflow-x-auto flex-1 relative">
                <div id="tableLoader" class="hidden absolute inset-0 bg-[#1A1A1A]/80 flex items-center justify-center z-10">
                    <div class="loader ease-linear rounded-full border-4 border-t-4 border-gray-700 h-10 w-10"></div>
                </div>

                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-[#333]">
                            <th class="py-4 px-4 text-gray-500 font-medium text-sm">Sl.No</th>
                            <th class="py-4 px-4 text-gray-500 font-medium text-sm">Customer / Order ID</th>
                            <th class="py-4 px-4 text-gray-500 font-medium text-sm">Location</th>
                            <th class="py-4 px-4 text-gray-500 font-medium text-sm">Items</th>
                            <th class="py-4 px-4 text-gray-500 font-medium text-sm">Price</th>
                            <th class="py-4 px-4 text-gray-500 font-medium text-sm">Discount</th>
                            <th class="py-4 px-4 text-gray-500 font-medium text-sm">Method</th>
                            <th class="py-4 px-4 text-gray-500 font-medium text-sm">Date</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="divide-y divide-[#252525]">
                        </tbody>
                </table>
            </div>

            <div id="paginationContainer" class="flex justify-center items-center mt-8 gap-2">
                </div>
        </div>
    </div>

    <script src="/js/admin/salesReport.js"></script>
