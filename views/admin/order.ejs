
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
      .search-bar {
          position: relative;
          width: 250px;
        }
        .search-bar i {
          position: absolute;
          left: 15px;
          top: 50%;
          transform: translateY(-50%);
          color: #a5a5a5;
        }
        .search-bar input {
          width: 100%;
          padding: 10px 15px 10px 40px;
          border-radius: 8px;
          border: 1px solid #333;
          background: #161616;
          color: #eaeaea;
          font-size: 0.9rem;
        }
        .pagination { display: flex; gap: 8px; }
        .pagination a {
          text-decoration: none;
          color: #a5a5a5;
          padding: 8px 14px;
          border-radius: 6px;
          background-color: #161616;
          border: 1px solid #333;
          font-size: 0.9rem;
          transition: all 0.3s;
        }
        .pagination a:hover { background-color: #333; color: #eaeaea; }
        .pagination a.active {
          background-color: #ff7e5f;
          color: #fff;
          border-color: #ff7e5f;
        }

        .swal2-popup {
            background: #1c1c1c !important;
            color: #e0e0e0 !important;
        }
        .swal2-title {
            color: #ffffff !important;
        }
        .swal2-confirm, .swal2-cancel {
            border-radius: 6px !important;
        }
        .fade-out {
            opacity: 0;
            transition: opacity 0.5s ease-out;
        }
    </style>

    <div class="min-h-screen p-4">
        <!-- Main Content -->
        <main class="flex-1 p-8">
            <!-- Header -->
            
         <div class="flex justify-between items-center mb-8">
              <h2 class="text-3xl font-bold text-white">Orders</h2>
              
              <form class="flex gap-4 items-center" id="controls-form">
                  <div>
                      <select name="status" id="status-filter" class="p-2.5 rounded-md border border-[#333] bg-[#161616] text-[#eaeaea] text-sm focus:ring-blue-500 focus:border-blue-500">
                          <option value="all" selected>All Statuses</option>
                          <option value="Pending">Pending</option>
                          <option value="Shipped">Shipped</option>
                          <option value="Delivered">Delivered</option>
                          <option value="Cancelled">Cancelled</option>
                          <option value="Returned">Returned</option>
                      </select>
                  </div>
                  
                  <div>
                      <select name="sort" id="sort-filter" class="p-2.5 rounded-md border border-[#333] bg-[#161616] text-[#eaeaea] text-sm focus:ring-blue-500 focus:border-blue-500">
                          <option value="newest" selected>Sort by Newest</option>
                          <option value="oldest">Sort by Oldest</option>
                          <option value="price_high">Price: High to Low</option>
                          <option value="price_low">Price: Low to High</option>
                      </select>
                  </div>
                  
                  <div class="search-bar">
                      <i class="fas fa-search"></i>
                      <input 
                          type="text" 
                          name="search"
                          placeholder="Search..." 
                          value="<%= typeof search !== 'undefined' ? search : '' %>"
                      />
                  </div>
              </form>
            </div>

            <div class="bg-[#1C1C1C] rounded-2xl p-6">
                <table class="w-full text-left">
                    <thead>
                        <tr>
                            <th class="text-gray-400 font-medium p-4">Order-Id</th>
                            <th class="text-gray-400 font-medium p-4">Address</th>
                            <th class="text-gray-400 font-medium p-4">Payment</th>
                            <th class="text-gray-400 font-medium p-4">Status</th>
                            <th class="text-gray-400 font-medium p-4">Price</th>
                            <th class="text-gray-400 font-medium p-4">Action</th>
                        </tr>
                    </thead>
                 <tbody class="divide-y divide-gray-700" id="orders-tbody">
                  <% data.forEach((order) => { %>
                  <tr >
                    <td class="p-4 text-white font-medium">#<%= order.order_id %></td>
                    <td class="p-4 text-white">
                      <%= [
                       order.address_name,
                       order.address_state,
                       order.address_country,
                      ].filter(Boolean).join(', ') %><br>
                      <%= [
                       order.address_pincode,
                       order.address_phone_number
                      ].filter(Boolean).join(', ') %>
                    </td>

                    <td class="p-4 text-gray-300"><%= order.payment_method %></td>
                    <td class="p-4 font-semibold
                        <%= order.status === 'Delivered' ? 'text-green-400' : 
                             order.status === 'Cancelled' ? 'text-red-400' : 
                             order.status === 'Returned' ? 'text-yellow-400' : 
                             'text-blue-400' %>">
                      <%= order.status %>
                    </td>
                    <td class="p-4 text-white">₹<%= order.total%></td>
                    <td class="p-4">
                      <button class="bg-green-600 hover:bg-green-700 text-white font-medium py-1 px-4 rounded-md transition-colors" data-id="<%=order._id%>">
                        More Details
                      </button>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
            </table>
            </div>

            
            <div class="pagination">
        <% if (totalPages > 1) { %>
            <% const searchParam = typeof search !== 'undefined' && search ? `&search=${search}` : '' %>
            <% if (currentPage > 1) { %>
                <a href="/admin/order=<%= currentPage - 1 %><%= searchParam %>">Previous</a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="/admin/order?page=<%= i %><%= searchParam %>" class="<%= i === currentPage ? 'active' : '' %>">
                    <%= i %>
                </a>
            <% } %>
            <% if (currentPage < totalPages) { %>
                <a href="/admin/order?page=<%= currentPage + 1 %><%= searchParam %>">Next</a>
            <% } %>
        <% } %>
    </div>
        </main>
    </div>

   <script src="/js/admin/order.js"></script>



