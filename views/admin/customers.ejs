<link rel="stylesheet" href="/css/admin/customers.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
.swal2-popup {
  background: #1c1c1c !important;
  color: #e0e0e0 !important;
}
.swal2-title { color: #fff !important; }
.swal2-confirm, .swal2-cancel { border-radius: 6px !important; }
</style>

<div class="page-header">
  <h2>Customers</h2>

  <div class="search-bar">
      <i class="fas fa-search"></i>
      <input id="searchInput" type="text" name="search" placeholder="Search by name or email..."
             value="<%= search || '' %>"
             onkeyup="fetchData()"
             >
      <a id="clear-search-btn" href="#" onclick="clearSearch(event)">
        <i class="fas fa-times"></i>
    </a>
  </div>
</div>

<div class="customer-table">
  <div class="customer-table-header">
    <div class="column-id">Id</div>
    <div class="column-name">Name</div>
    <div class="column-email">Email</div>
    <div class="column-mobile">Mobile</div>
    <div class="column-address">Address</div>
    <div class="column-action">Action</div>
  </div>

  <div id="customer-rows">
    <% if (customers.length) { %>
      <% customers.forEach((cust, i) => { %>
        <% const id = (pagination.currentPage - 1) * pagination.limit + i + 1 %>
        <div class="customer-row">
          <div class="column-id"><%= id %></div>
          <div class="column-name"><%= cust.username %></div>
          <div class="column-email"><%= cust.email %></div>
          <div class="column-mobile"><%= cust.phone || '-' %></div>
          <div class="column-address">
            <%= cust.address ? `${cust.address.house_name}, ${cust.address.city}` : 'No Address' %>
          </div>
          <div class="column-action">
            <a href="#"
               class="btn-toggle <%= cust.isBlocked ? 'btn-unblock' : 'btn-block' %>"
               data-id="<%= cust._id %>"
               data-status="<%= cust.isBlocked ? 'blocked' : 'active' %>">
               <%= cust.isBlocked ? 'Unblock' : 'Block' %>
            </a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="customer-row">No customers found</div>
    <% } %>
  </div>
</div>

<div class="page-footer">
<div class="pagination" id="pagination">
  <% if (pagination.totalPages > 1) { %>
    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
      <a href="#" 
         onclick="changePage(<%= i %>, event)" 
         class="<%= i === pagination.currentPage ? 'active' : '' %>">
         <%= i %>
      </a>
    <% } %>
  <% } %>
</div>
</div>

<script src="/js/admin/customers.js"></script>

<script>
  
  let currentPage = <%= pagination.currentPage %>
  const limit = <%= pagination.limit %>

  </script>


