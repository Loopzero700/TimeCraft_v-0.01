<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="/css/admin/dashboard.css">
<style>

</style>

<div class="dashboard-content">

    <div class="chart-section">
        <div class="chart-header">
            <h3>Sales Statistics</h3>
            <div class="select-wrapper">
                <select id="chartFilter" onchange="updateChart(this.value)">
                    <option value="weekly">Last 7 Days</option>
                    <option value="monthly" selected>This Month</option>
                    <option value="yearly">This Year</option>
                </select>
            </div>
        </div>
        <div class="chart-container">
            <canvas id="ordersChart"></canvas>
        </div>
    </div>

    <div class="charts-grid-3">
    
    <div class="chart-box">
        <h3>Top Products</h3>
        <div class="canvas-wrapper">
            <canvas id="productsChart"></canvas>
        </div>
    </div>

    <div class="chart-box">
        <h3>Category Distribution</h3>
        <div class="canvas-wrapper">
            <canvas id="categoryChart"></canvas>
        </div>
    </div>

    <div class="chart-box">
        <h3>Brand Performance</h3>
        <div class="canvas-wrapper">
            <canvas id="brandsChart"></canvas>
        </div>
    </div>

</div>

    <div class="top-performers-grid">
        
        <div class="performer-card">
            <h3>Best Selling Products <span class="badge">Month</span></h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th class="text-right">Units Sold</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(topProducts && topProducts.length > 0) { %>
                            <% topProducts.forEach(product => { %>
                                <tr>
                                    <td class="product-name" title="<%= product.name %>">
                                        <%= product.name %>
                                    </td>
                                    <td class="text-right count"><%= product.totalSold %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="2" class="no-data">No sales this month</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="performer-card">
            <h3>Best Categories <span class="badge">Month</span></h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th class="text-right">Units Sold</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(topCategories && topCategories.length > 0) { %>
                            <% topCategories.forEach(cat => { %>
                                <tr>
                                    <td><%= cat.name %></td>
                                    <td class="text-right count"><%= cat.totalSold %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="2" class="no-data">No sales this month</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="performer-card">
            <h3>Best Brands <span class="badge">Month</span></h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Brand Name</th>
                            <th class="text-right">Units Sold</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(topBrands && topBrands.length > 0) { %>
                            <% topBrands.forEach(brand => { %>
                                <tr>
                                    <td><%= brand.brand.brandName %></td>
                                    <td class="text-right count"><%= brand.totalSold %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="2" class="no-data">No sales this month</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script src="/js/admin/dashboard.js"></script>

<script>
    const topProductsData = <%- JSON.stringify(topProducts || []) %>
    const topCategoriesData = <%- JSON.stringify(topCategories || []) %>
    const topBrandsData = <%- JSON.stringify(topBrands || []) %>
    
</script>
