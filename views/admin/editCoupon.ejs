<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Pacifico&display=swap" rel="stylesheet">

<script src="https://unpkg.com/@phosphor-icons/web"></script>
<style>

    .swal2-popup {
        background: #1c1c1c !important;
        color: #e0e0e0 !important;
    }
    .swal2-title {
        color: #ffffff !important;
    }
    .swal2-confirm, .swal2-cancel {
        border-radius: 6px !important;
    }
    .fade-out {
        opacity: 0;
        transition: opacity 0.5s ease-out;
    }
    </style>

<script>
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: {
                    'sans': ['Inter', 'sans-serif'],
                    'logo': ['Pacifico', 'cursive'],
                },
                colors: {
                    'brand-dark': '#111111',
                    'brand-light-dark': '#1C1C1C',
                    'brand-input': '#333333',
                    'brand-border': '#444444',
                    'brand-text-light': '#E0E0E0',
                    'brand-text-dim': '#9E9E9E',
                    'brand-sidebar-active': '#007AFF',
                }
            },
        },
    }
</script>


<main class="w-full max-w-5xl mx-auto">
    <div class="bg-brand-light-dark rounded-2xl p-6 mb-8">
        <h2 class="text-xl font-semibold text-white">Edit Coupon</h2>
    </div>

    <div class="bg-brand-light-dark rounded-2xl p-8">
        <form id="form">
    <input type="hidden" name="couponId" value="<%= coupon._id %>">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">

        <div>
            <label for="coupon-code" class="block text-sm font-medium text-brand-text-dim mb-2">Coupon Code</label>
            <input type="text" id="coupon-code" name="code" class="w-full bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" 
                   value="<%= coupon.code %>" onblur="this.value = this.value.trim()" >
            <p class="text-red-500 text-sm mt-1 hidden" id="error-coupon-code"></p>
        </div>

        <div>
            <label for="discount-type" class="block text-sm font-medium text-brand-text-dim mb-2">Discount</label>
            <div class="flex space-x-2">
                <select id="discount-type" name="discountType" class="w-1/3 bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                    <option value="percentage" <%= coupon.discountType === 'percentage' ? 'selected' : '' %>>%</option>
                    <option value="fixed" <%= coupon.discountType === 'fixed' ? 'selected' : '' %>>₹</option>
                </select>
                <div class="w-2/3">
                    <input type="number" id="discount-amount" name="discountAmount" placeholder="Amount" min="0" step="0.01" class="w-full bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" 
                           value="<%= coupon.discountAmount %>" required>
                    <p class="text-red-500 text-sm mt-1 hidden" id="error-discount-amount"></p>
                </div>
            </div>
        </div>

         <div>
            <label for="expiry-date" class="block text-sm font-medium text-brand-text-dim mb-2">starting Date</label>
            <input type="date" id="starting-date" name="startingDate" class="w-full bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500"
            value="<%= coupon.startingDate.toISOString().split('T')[0] %>" required>
            <p class="text-red-500 text-sm mt-1 hidden" id="error-starting-date"></p>
        </div>

        <div>
            <label for="expiry-date" class="block text-sm font-medium text-brand-text-dim mb-2">Expiry Date</label>
            <input type="date" id="expiry-date" name="expiryDate" class="w-full bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500" 
                   value="<%= coupon.expiryDate.toISOString().split('T')[0] %>" required>
            <p class="text-red-500 text-sm mt-1 hidden" id="error-expiry-date"></p>
        </div>

        <div>
            <label for="max-users" class="block text-sm font-medium text-brand-text-dim mb-2">Max Uses</label>
            <input type="number" id="max-users" name="maxUsers" placeholder="e.g., 100" min="0" step="1" class="w-full bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-white-500"
                   value="<%= coupon.maxUsers || '' %>">
            <p class="text-red-500 text-sm mt-1 hidden" id="error-max-users"></p>
        </div>
        
        <div>
            <label for="maxDiscount" class="block text-sm font-medium text-brand-text-dim mb-2">Max Discount</label>
            <input type="number" id="maxDiscount" name="maxDiscount" placeholder="0.00" min="0" step="0.01" class="w-full bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500"
                   value="<%= coupon.maxDiscount || '' %>">
            <p class="text-red-500 text-sm mt-1 hidden" id="error-maxDiscount"></p>
        </div>

        <div>
            <label for="min-purchase" class="block text-sm font-medium text-brand-text-dim mb-2">Min Purchase</label>
            <input type="number" id="min-purchase" name="minPurchase" placeholder="0.00" min="0" step="0.01" class="w-full bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500"
                   value="<%= coupon.minPurchase || '' %>">
            <p class="text-red-500 text-sm mt-1 hidden" id="error-min-purchase"></p>
        </div>
        
        <div></div> 
    </div>

    <div class="mt-6">
        <label for="coupon-description" class="block text-sm font-medium text-brand-text-dim mb-2">Coupon Description</label>
        <textarea id="coupon-description" name="description" rows="3" class="w-full bg-brand-input border border-brand-border text-brand-text-light rounded-lg p-3.5 focus:outline-none focus:ring-2 focus:ring-blue-500"><%= coupon.description || '' %></textarea>
        <p class="text-red-500 text-sm mt-1 hidden" id="error-coupon-description"></p>
    </div>

    <div class="mt-10 flex justify-end"> 
        <button type="submit" class="bg-white text-black font-semibold text-lg py-3 px-12 rounded-lg hover:bg-gray-200 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-brand-light-dark focus:ring-white">
            Save Changes
        </button>
    </div>
</form>
    </div>
</main>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/admin/editCoupon.js"></script>
