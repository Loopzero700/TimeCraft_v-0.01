<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TimeCraft</title>
  

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Pacifico&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">



  <link rel="stylesheet" href="/css/user/main.css">
</head>
<body>
  
<header class="site-header">
  <div class="header-container">
    <nav class="main-nav">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Shop</a></li>
        <li><a href="/contact">Contact Us</a></li>
        <li><a href="/about">About Us</a></li>
      </ul>
    </nav>

    <nav role="navigation" class="hamburger-nav">
      <div id="menuToggle">
        <input type="checkbox" />
        <span></span>
        <span></span>
        <span></span>
        <ul id="menu">
          <li><a href="/">Home</a></li>
          <li><a href="/shop">Shop</a></li>
          <li><a href="/contact">Contact Us</a></li>
          <li><a href="/about">About Us</a></li>
        </ul>
      </div>
    </nav>

    <div class="logo">
      <a href="/">TimeCraft</a>
    </div>


    <div class="header-icons">
    <a href="/Wishlist" class="icon-container">
    <span class="material-symbols-outlined">favorite</span>
    <span id="wishlist-badge" class="badge hidden">0</span>
  </a>

  <a href="/cart" class="icon-container">
    <span class="material-symbols-outlined">shopping_cart</span>
    <span id="cart-badge" class="badge hidden">0</span>
  </a>

     
      <% if (typeof user !== 'undefined' && user) { %>
  <button id="user-menu-button" class="icon-button">
    <a href="/account">
    <span class="material-symbols-outlined">person</span>
    </a>
  </button>
  

      <% } else { %>
        
        <a href="/login">
  <button class="login-btn">
    Login
  </button>
</a>
      <% } %>

    </div>
  </div>
</header>

<main>
  <div class="container">
    <%- body %>
  </div>
</main>

<!-- Footer -->
<footer class="site-footer">
    <div class="footer-container">
      <div class="logo-footer">
        <a href="/">TimeCraft</a>
      </div>
      <div class="footer-links">
        <div>
          <h4>Shop</h4>
          <a href="#">Men</a><br>
          <a href="#">Women</a><br>
          <a href="#">Accessories</a>
        </div>
        <div>
          <h4>Company</h4>
          <a href="#">About Us</a><br>
          <a href="#">Careers</a><br>
          <a href="#">Press</a>
        </div>
        <div>
          <h4>Support</h4>
          <a href="#">Help Center</a><br>
          <a href="#">Returns</a><br>
          <a href="#">Shipping</a>
        </div>
        <div>
          <h4>Follow Us</h4>
          <a href="#">Instagram</a><br>
          <a href="#">Twitter</a><br>
          <a href="#">Facebook</a>
        </div>
      </div>
      <p class="footer-copy">© 2025 TimeCraft. All rights reserved.</p>
    </div>
</footer>


<script>
    
    const userMenuButton = document.getElementById('user-menu-button')

   
        const userMenu = document.getElementById('user-menu')

        
        userMenuButton.addEventListener('click', function(event) {
            event.stopPropagation(); 
            userMenu.classList.toggle('show')
        })

       
        window.addEventListener('click', function(event) {
           if (userMenu && !userMenu.contains(event.target) && !userMenuButton.contains(event.target)) {
              if (userMenu.classList.contains('show')) {
                      userMenu.classList.remove('show')
              }
          }
        })


      window.updateCartCount = async function() {

        try {
          const respons = await fetch('/cart/counts')

          if(respons.ok){
            const data = await respons.json()

            console.log(data)

            const wishlistBadge = document.getElementById('wishlist-badge')
            if(data.wishlistCount > 0){
              wishlistBadge.innerText = data.wishlistCount;
              wishlistBadge.classList.remove('hidden')
            }else{
              wishlistBadge.classList.add('hidden')
            }

            const cartBadge = document.getElementById('cart-badge')
            if(data.cartCount > 0){
              cartBadge.innerText = data.cartCount;
              cartBadge.classList.remove('hidden')
            }else{
              cartBadge.classList.add('hidden')
            }

          }

        } catch (error) {
          console.log(error)
        }

      }

      document.addEventListener('DOMContentLoaded',()=>{
        window.updateCartCount()
      })
    
</script>


</body>
</html>
