<script src="https://cdn.tailwindcss.com"></script>
<section class="relative flex flex-col items-center justify-center min-h-[60vh] py-12 px-4">

    <a href="/login" class="absolute top-0 right-4 text-sm text-gray-500 hover:text-black underline">
        Skip
    </a>

    <div class="w-full max-w-sm">
        
        <div class="text-center mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Referral Code</h2>
            <p class="text-gray-500 text-sm mt-1">Enter your code to claim your bonus.</p>
        </div>

        <div class="flex gap-2">
            <input 
                type="text" 
                id="referralCode" 
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors"
                placeholder="REF-1234"
                autocomplete="off"
            >
            <button 
                id="applyBtn"
                onclick="handleApply()"
                class="bg-black text-white px-6 py-2.5 rounded-lg font-medium hover:bg-gray-800 transition-colors disabled:bg-gray-400"
            >
                Apply
            </button>
        </div>

        <div id="msgArea" class="mt-3 text-sm text-center h-5 opacity-0 transition-opacity">
            </div>

    </div>
</section>

<script src="/js/user/referral.js"></script>