
    <script src="https://cdn.tailwindcss.com"></script>

    <main class="container mx-auto px-6 py-12">
        <h2 class="text-3xl font-bold mb-8">Checkout</h2>
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
            
            <!-- Left Side: Shipping & Payment -->
            <div class="lg:col-span-3 bg-white border border-gray-200 rounded-lg p-8 h-fit">
                <!-- Tabs -->
                <div class="flex border-b mb-6">
                    <button id="shippingTab" class="py-2 px-1 border-b-2 border-black font-semibold">Shipping</button>
                    <button id="paymentTab" class="py-2 px-4 text-gray-500 hidden">Payment Mode</button>
                </div>

                <!-- Content Sections -->
                <div id="shippingContent">
                     <h3 class="text-lg font-semibold mb-4">Shipping Address</h3>
                     <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <%address.forEach((data,i)=>{%>
                         <label class="relative block p-4 border-2 border-black rounded-lg bg-gray-50 cursor-pointer">
                            <%if(data.is_default){%>
                            <input type="radio" name="address" class="hidden peer" checked value="<%= data._id %>">
                            <%}else{%>
                            <input type="radio" name="address" class="hidden peer" value="<%= data._id %>">
                            <%}%>
                         
                            <p class="font-semibold text-sm">Address <%=1+i%></p>
                            <div class="text-xs text-gray-600 mt-1 address-details">
                                <p class="name"><%=data.name%></p>
                                <p class="line1"><%=data.house_name%>, <%=data.locality%>, <%=data.city%></p>
                                <p class="line2"><%=data.state%>, <%=data.country%></p>
                                <p class="postal"><%=data.pincode%></p>
                                <p class="contact">Contact number : <%=data.phone_number%></p>
                            </div>
                        </label>
                        <%})%>
                    </div>
                   
                    <button class="bg-black hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded my-4" id="address">
                     Add address
                    </button>

                </div>

<div>
    <h3 class="text-lg font-semibold mb-4">Select Payment Mode</h3>
    
    <div class="space-y-3">

        <label class="flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer transition-all duration-200 hover:border-gray-400
                    has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50
                    has-[:checked]:[&_.radio-outer]:border-blue-600
                    has-[:checked]:[&_.radio-dot]:scale-100">
            
            <input type="radio" name="payment_mode" class="hidden" value="Razorpay">
            
          
            
            <div>
                <span class="font-medium text-gray-800">Razorpay</span>
                <p class="text-sm text-gray-500">Pay with Card, UPI, Netbanking, etc.</p>
            </div>
        </label>

        <label class="flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer transition-all duration-200 hover:border-gray-400
                    has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50
                    has-[:checked]:[&_.radio-outer]:border-blue-600
                    has-[:checked]:[&_.radio-dot]:scale-100">
            
            <input type="radio" name="payment_mode" class="hidden" value="Wallet">
            
            
            
            <div>
                <span class="font-medium text-gray-800">Wallet</span>
                <p class="text-sm text-gray-500">Use your account wallet balance.</p>
            </div>
        </label>

        <label class="flex items-center p-4 border border-gray-200 rounded-lg cursor-pointer transition-all duration-200 hover:border-gray-400
                    has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50
                    has-[:checked]:[&_.radio-outer]:border-blue-600
                    has-[:checked]:[&_.radio-dot]:scale-100">
            
            <input type="radio" name="payment_mode" class="hidden" value="COD" checked> 
            
            <div>
                <span class="font-medium text-gray-800">Cash On Delivery</span>
                <p class="text-sm text-gray-500">Pay with cash upon delivery.</p>
            </div>
        </label>

    </div>
</div>
            </div>

            <!-- Right Side: Summary -->
            <div class="lg:col-span-2">
                <div class="space-y-6">
                    <!-- Shipping Address -->
                    <div class="bg-white border border-gray-200 rounded-lg p-6">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-lg font-semibold">Shipping Address</h3>
            
                        </div>
                        <div id="shippingSummary" class="text-sm text-gray-600">
                           
                        </div>
                    </div>
                    <!-- Order Summary -->
                     <div class="space-y-4 bg-white border border-gray-200 rounded-lg p-6">
                        <h3 class="text-lg font-semibold mb-4">Order Summary</h3>
                      <%products.forEach((item)=>{%>
                       <div id="productList" class="divide-y divide-gray-200">
                   
                   <div class="flex items-start space-x-4 py-4">
                        <div class="flex-shrink-0">
                            <img src="<%=item.image%>" alt="Product Name" class="w-20 h-20 object-cover rounded-lg border border-gray-200">
                        </div>
                        <div class="flex-grow min-w-0">
                            <h4 class="font-semibold text-md text-gray-800 truncate"><%=item.name%></h4>
                            <p class="text-sm text-gray-500">Qty:<%=item.quantity%></p>
                        </div>
                        <div class="text-md font-semibold text-gray-800 text-right">
                            <span>₹<%=item.price*item.quantity%></span>
                        </div>
                    </div>
                        <%})%>
                        <hr>
                        
                        <div class="space-y-3 text-sm">
    
                        <div class="flex justify-between">
                            <span class="text-gray-600">Item Sub Total</span>
                            <span>₹ <%= totalAmt + couponDiscount %></span>
                        </div>

                        <% if (couponDiscount > 0) { %>
                            <div id="discountRow" class="flex justify-between text-green-600 text-lg font-medium">
                                <span>Coupon Discount</span>
                                <span id="discountAmount">- ₹ <%= couponDiscount %></span>
                            </div>
                        <% } %>

                        <div class="flex justify-between">
                            <span class="text-gray-600">Total Saved Amount</span>
                            <span class="text-green-600">₹ <%= save %></span>
                        </div>

                        <div class="flex justify-between">
                            <span class="text-gray-600">Shipping</span>
                            <span class="font-semibold text-green-600">Free</span>
                        </div>

                        <div class="border-t pt-3 mt-3 flex justify-between font-bold text-base">
                            <span>Total Payable</span>
                            <span>₹ <%= totalAmt %></span>
                        </div>
                    </div>
                    </div>
                    <!-- Order Button -->
                    <button id="orderNowBtn" class="w-full bg-black text-white font-bold py-3 rounded-lg hover:bg-gray-800 transition-colors">ORDER NOW</button>
                </div>
            </div>
        </div>
    </main>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <script src="/js/user/checkout.js"></script>


