    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>

   
            
            <%if(cart.length==0){%>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
   
    <div class="w-full max-w-lg mx-auto p-4 md:p-8">
        <div class="bg-white rounded-2xl shadow-xl text-center p-8 md:p-12">
            <!-- More illustrative shopping bag icon -->
            <div class="mb-6">
                <svg class="w-24 h-24 mx-auto text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
            </div>
            
            <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-3">Your Cart is Empty</h1>
            
            <p class="text-gray-600 mb-8 text-lg">Looks like you haven't added anything yet. Let's find something for you!</p>
            
            <a href="/shop" class="inline-block bg-black text-white font-bold py-4 px-10 rounded-xl shadow-lg hover:bg-gray-700 transition-all duration-300 ease-in-out transform hover:-translate-y-1">
                Continue Shopping
            </a>
            
            
            <div class="my-8 border-t border-gray-200"></div>

        </div>
    </div>

                <%}else{%>
             
    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <h1 class="text-3xl font-bold text-gray-800 mb-8">My Cart</h1>

        <div class="flex flex-col lg:flex-row gap-12">
            <div class="flex-grow">
                <div class="bg-white rounded-lg shadow-md">
             
                    <div class="hidden md:grid grid-cols-6 gap-4 font-semibold text-gray-600 bg-gray-100 p-4 rounded-t-lg">
                        <div class="col-span-3">Product</div>
                        <div class="text-center">Price</div>
                        <div class="text-center">Quantity</div>
                        <div class="text-right">Total</div>
                    </div>
                    <%cart.forEach(cart=>{%>
                
                    <div class="grid grid-cols-1 md:grid-cols-6 gap-4 items-center p-4 border-b product-item" id="<%=cart.cart_id%>">
                        <div class="col-span-1 md:col-span-3 flex items-center gap-4">
                            <img src="<%=cart.image%>" alt="Chronograph Men's Watch" class="rounded-md w-20 h-20 object-cover">
                            <div>
                                <p class="font-semibold text-gray-800"><%=cart.name%></p>
                                <button class="text-red-500 text-sm font-medium hover:underline" id="removebtn" data-id="<%=cart.cart_id%>">Remove</button>
                              <% if (!cart.isListed || cart.status==='inactive') { %>
                                  <p class="text-sm text-gray-500">Unavailable</p>
                              <% } else if (cart.stock <= 0) { %>
                                  <p class="text-sm text-red-600">Out of Stock</p>
                              <% } else { %>
                                  <p class="text-sm text-green-600">In Stock</p>
                              <% } %>
                              
                                    <p><%=cart.stock%></p>
                            </div>
                        </div>
                        <div class="text-center font-medium price" data-price="<%=cart.price%>">₹<%=cart.price%></div>
                        <div class="flex justify-center items-center">
                            <%if(cart.stock>0){%>
                            <div class="flex items-center border border-gray-300 rounded-md">
                                <button class="px-3 py-1 text-gray-600 hover:bg-gray-100 minus-btn" data-stock=<%=cart.stock%>  data-id="<%=cart.cart_id%>">-</button>
                                <input type="text" class="w-12 text-center border-0 focus:ring-0 quantity" value="<%=cart.quantity%>" readonly>
                                <button class="px-3 py-1 text-gray-600 hover:bg-gray-100 plus-btn" data-stock=<%=cart.stock%>  data-id="<%=cart.cart_id%>">+</button>
                            </div>
                            <%}%>
                        </div>
                        <div class="text-right font-bold text-lg total-price">₹<%=cart.price*cart.quantity%></div>
                    </div>
                    <%})%>
                </div>
            </div>
            
            <!-- Order Summary -->
            <div class="lg:w-1/3">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-bold mb-4">Order Summary</h2>
                    <div class="space-y-3">
                        <div class="flex justify-between text-gray-600">
                            <span>Item Sub Total</span>
                            <span id="subtotal">₹0</span>
                        </div>
                    
                        <div id="discountRow" class="flex justify-between text-green-600 text-lg font-medium hidden">
                            <span>Discount</span>
                            <span id="discountAmount">- ₹0</span>
                        </div>
                    
                        <div class="flex justify-between text-gray-600">
                            <span>Shipping</span>
                            <span>Free</span>
                        </div>
                    
                        <div class="border-t border-gray-200 pt-4 mt-4">
                            <div class="flex justify-between font-bold text-xl text-gray-800">
                                <span>Total</span>
                                <span id="grand-total">₹0</span>
                            </div>
                        </div>
                    </div>

                    
                <div class="mt-6">
                    <label class="text-gray-700 font-medium">Coupon Code</label>
                
                    <div class="flex gap-3 mt-2" id="couponArea">
                        <input 
                            type="text" 
                            id="couponInput" 
                            placeholder="Enter coupon code"
                            class="flex-grow px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black"
                            value="<%=couponCode?couponCode:''%>"
                        >

                        <button 
                            id="applyCouponBtn"
                            class="bg-black text-white font-semibold px-6 rounded-lg hover:bg-gray-800 transition">
                            APPLY
                        </button>
                    </div>
                
                    <button 
                        id="removeCouponBtn" 
                        class="hidden mt-3 text-red-500 underline text-sm <%= couponAmount ? '' : 'hidden' %>">
                        Remove Coupon
                    </button>
                
                    <p id="couponMessage" class="text-sm mt-2"></p>
                </div>


                    
                    <button class="w-full bg-black text-white font-bold py-3 px-4 rounded-lg mt-6 hover:bg-gray-800 transition-colors" id="checkoutBtn">
                        CHECKOUT
                    </button>
                </div>
            </div>
        </div>
    </main>
    <%}%>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    let couponCode = "<%= couponCode || '' %>";
</script>
    <script src="/js/user/cart.js"></script>


