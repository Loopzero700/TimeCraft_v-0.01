<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/user/addAddress.css">
<link rel="stylesheet" href="/css/user/account.css">
<div class="account-page-container">
    

<aside class="account-sidebar">
    <div class="account-sidebar-card">
        <h2 class="sidebar-title">My Account</h2>
            <nav class="sidebar-nav">
                <a href="/account" class="nav-link">
                    <span class="material-symbols-outlined">person</span>
                    <span>Personal Information</span>
                </a>
                <a href="/account/address" class="nav-link active">
                    <span class="material-symbols-outlined">home</span>
                    <span>Address</span>
                </a>
                <a href="#" class="nav-link">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <span>Order</span>
                </a>
                <a href="#" class="nav-link">
                    <span class="material-symbols-outlined">account_balance_wallet</span>
                    <span>Wallet</span>
                </a>
                <form action="/logout" method="POST" style="margin:0; padding:0;">
                <button class="nav-link">
                    <span class="material-symbols-outlined">logout</span>
                    <span>Logout</span>
                </button>
            </form>
        </nav>
    </div>
</aside>

    <section class="account-content">
        <div class="content-card">
            <h2 class="content-title">Add New Address</h2>

            <form action="/account/address/add" method="POST" class="profile-form" id="addressForm" novalidate>
                <div class="form-group">
                    <label for="name" class="form-label">Full Name</label>
                    <input type="text" id="name" name="name" class="form-input" required>
                    <div id="error1" class="error-message"></div>
                </div>

                <div class="form-group">
                    <label for="mobile" class="form-label">Mobile Number</label>
                    <input type="tel" id="mobile" name="mobile" class="form-input" required>
                    <div id="error2" class="error-message"></div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="house" class="form-label">House No., Building Name</label>
                        <input type="text" id="house" name="house" class="form-input" required>
                        <div id="error3" class="error-message"></div>
                    </div>
                    <div class="form-group">
                        <label for="street" class="form-label">Street, Area, Colony</label>
                        <input type="text" id="street" name="street" class="form-input" required>
                        <div id="error4" class="error-message"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="city" class="form-label">City</label>
                        <input type="text" id="city" name="city" class="form-input" required>
                        <div id="error5" class="error-message"></div>
                    </div>
                    <div class="form-group">
                        <label for="state" class="form-label">State</label>
                        <input type="text" id="state" name="state" class="form-input" required>
                        <div id="error6" class="error-message"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="pincode" class="form-label">Pincode</label>
                        <input type="text" id="pincode" name="pincode" class="form-input" required>
                        <div id="error7" class="error-message"></div>
                    </div>
                    <div class="form-group">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" id="country" name="country" class="form-input" value="India" required>
                        <div id="error8" class="error-message"></div>
                    </div>
                </div>
                
                <div class="form-checkbox-group">
                    <input type="checkbox" id="isDefault" name="isDefault" class="form-checkbox">
                    <label for="isDefault" class="form-checkbox-label">Make this my default address</label>
                </div>

                <div class="form-actions">
                    <a href="/account/address" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn">Save Address</button>
                </div>
            </form>
        </div>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/user/addAddress.js"></script>