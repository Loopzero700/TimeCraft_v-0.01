<link rel="stylesheet" href="/css/user/productDetailed.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
 <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


<nav aria-label="Breadcrumb">
    <ol class="breadcrumbs">
        <% breadcrumbs.forEach(function(crumb) { %>
            <li class="breadcrumb-item">
                <% if (crumb.active) { %>
                    <span aria-current="page"><%= crumb.name %></span>
                <% } else { %>
                    <a href="<%= crumb.link %>"><%= crumb.name %></a>
                <% } %>
            </li>
        <% }); %>
    </ol>
</nav>
<main class="container">


    <section class="product-section">

       <div class="image-gallery">
            <div class="thumbnails">
                <% productData.variants[0].image_url.forEach(function(image, index) { %>
                    <img src="<%=image%>" alt="Watch Thumbnail"
                        class="thumbnail-img <%= index === 0 ? 'active' : '' %>">
                        <% }); %>
                    </div>
                    <div class="main-image-container">
                <img id="main-product-image" src="<%=productData.variants[0].image_url[0]%>"
                data-zoom-image="<%=productData.variants[0].image_url[0]%>" alt="<%=productData.name%>"
                class="main-image">
            </div>
        </div>

        <div class="product-details">
            </div>
        
            
            <div class="product-details">
                <div class="details-header">
                    <h1 class="product-title">
                        <%=productData.name%>
                    </h1>
                    <button class="wishlist-btn" data-id="<%= productData._id %>">
                        <%if(WishlistData.includes(productData._id.toString())){%>
                        <i class="fa-solid fa-heart heart-Icon"></i>
                        <%}else{%>
                        <i class="fa-regular fa-heart heart-Icon"></i>
                        <%}%>  
                </button>
            </div>
            
            <div class="price-container">
    <% 
        const variant = productData.variants[0];
        const originalPrice = variant.price;
                
        let currentPrice = variant.discounted_price; 
        let discount = 0;

        if (!currentPrice) {
            currentPrice = originalPrice;
        } 
        
        else if (currentPrice < originalPrice) {
            discount = Math.round(((originalPrice - currentPrice) / originalPrice) * 100); 
        }
    %>

    <span class="price-main">₹<%= currentPrice %></span>
    
    <% if (discount > 0) { %>
        <span class="price-original">₹<%= originalPrice %></span>
    <% } %>
    
    <% if (discount > 0) { %>
        <span class="price-discount">
            <%= discount %>% off
        </span>
    <% } %>
</div>
            
            <div class="product-info">
                <h3 class="info-title">Product Details</h3>
                <p class="sku">SKU: <%=productData.variants[0].SKU%>
                </p>
               <p class="stock inline-flex items-center px-1.5 py-0.5 rounded text-lg font-bold text-black border-2 border-black">
                    stock: <%=productData.variants[0].stock%>
               </p>
            </div>
            
            <div>
                <h3 class="color-title">Select Color</h3>
                <div class="color-selector">
                    <%productData.variants.forEach(function(variant,index){%>
                        <input type="radio" id="color-<%= variant.color %>-<%= index %>" name="color"
                        value="<%= variant.color %>" data-index="<%= index %>" <%=index===0 ? 'checked' : '' %>
                        >
                        <label for="color-<%= variant.color %>-<%= index %>">
                            <%= variant.color %>
                        </label>
                        <%}) %>
                    </div>
                </div>
               <div class="actions-container" style="<%= productData.variants[0].stock == 0 ? 'display:none;' : '' %>">
                <button class="btn" id="addCart" data-id="<%=productData._id%>">Add To Cart</button>
            </div> 

            <div class="out-Of-stock" style="<%= productData.variants[0].stock > 0 ? 'display:none;' : '' %>">
         <h3>OUT OF STOCK</h3>
        </div>
            
        </div>

    </section>
    <div class="flex justify-center">
        <div class="description">
            <h3 class="text-lg font-bold mb-2">Description</h3>
            
            <p id="desc-<%= productData._id %>" class="text-gray-700 line-clamp-3 transition-all duration-300">
                <%= productData.description %>
            </p>
            
            <button 
            id="btn-<%= productData._id %>"
            onclick="toggleReadMore('<%= productData._id %>')"
            class="mt-2 text-blue-600 hover:text-blue-800 text-sm font-medium focus:outline-none"
            >
            Read More
        </button>
    </div>
</div>
    



    <section class="similar-section">
        <h2 class="section-title centered">Similar Collection</h2>
        <div class="similar-grid">
            <%cat.forEach(function(product){%>
                <%let discountPrice = product.variants[0].discounted_price
                  if(!discountPrice){
                    discountPrice = product.variants[0].price
                  }  
                %>
                <div class="product-card">
                    <div class="product-card-image-wrapper">
                        <a href="/product/<%= product._id %>"> <img src="<%=product.variants[0].image_url[0]%>"
                                alt="<%=product.name%>" class="product-card-image">
                        </a>
                       
                    </div>
                    <h3 class="product-card-title">
                        <%=product.name%>
                    </h3>
                    <p class="product-card-price">
                        <span class="font-bold">
                            ₹<%=discountPrice%>
                        </span>
                        <%if(product.variants[0].discounted_price){%>
                        <span class="line-through">
                            ₹<%=product.variants[0].price%>
                        </span>
                        <%}%>
                    </p>
                </div>
                <%})%>
        </div>
    </section>
</main>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/elevatezoom/3.0.8/jquery.elevatezoom.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const productData = <%- JSON.stringify(productData) %>
</script>
<script src="/js/user/productDetailed.js"></script>