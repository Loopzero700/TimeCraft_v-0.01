<link rel="stylesheet" href="/css/user/forgotPassword.css">

<main class="main-content">
  <div class="form-container">
    <h2>Enter your new Password</h2>
    <form id="forgotForm">
      <div class="input-group">
          <div id="error1" class="error-message"></div>
        <input 
          type="password" 
          id="newPassword" 
          name="newPassword" 
          placeholder="New Password" 
        >
         <div id="error2" class="error-message"></div>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          placeholder="Confirm Password" 
        >
      </div>
      <button type="button" class="submit-btn">Submit</button>
    </form>
  </div>
</main>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const newPassword = document.getElementById('newPassword')
    const confirmPassword = document.getElementById('confirmPassword')
    const submitbtn = document.querySelector('.submit-btn')
    

    const error1 = document.getElementById('error1')
    const error2 = document.getElementById('error2')

    function passVaildateChecking() {
    const passval = newPassword.value
    const cpassval = confirmPassword.value
    const alpha = /[a-zA-Z]/
    const digit = /\d/

    if (passval.length < 8) {
      error1.style.display = "block"
      error1.innerHTML = "Should contain at least 8 characters"
    } else if (!alpha.test(passval) || !digit.test(passval)) {
      error1.style.display = "block"
      error1.innerHTML = "Password should contain letters and numbers"
    } else {
      error1.style.display = "none"
      error1.innerHTML = ""
    }

    if (cpassval === '') {
      error2.style.display = "none"
      error2.innerHTML = ""
    } else if (passval !== cpassval) {
      error2.style.display = "block"
      error2.innerHTML = "Passwords do not match"
    } else {
      error2.style.display = "none"
      error2.innerHTML = ""
    }
  }

  newPassword.addEventListener('input', passVaildateChecking)
  confirmPassword.addEventListener('input', passVaildateChecking)


submitbtn.addEventListener('click', async (e) => {
  e.preventDefault()
  passVaildateChecking()
  if (error1.innerHTML !== '' || error2.innerHTML !== '') return

  const newPass = newPassword.value.trim()

  try {
    const response = await fetch('/account/setNewPassword', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ newPassword: newPass })
    })

    const result = await response.json()
    console.log(result)

    if (result.success) {
      Swal.fire({
        icon: 'success',
        title: 'Password Changed!',
        text: result.message
      }).then(() => {
        window.location.href = '/account'
      })
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: result.message || 'Something went wrong!'
      })
    }
  } catch (err) {
    console.error(err)
    Swal.fire({
      icon: 'error',
      title: 'Oops...',
      text: 'Server error. Try again later.'
    })
  }
})

</script>
