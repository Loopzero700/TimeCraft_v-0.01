    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="/css/user/account.css">

        <style>
    .breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0; 
    font-size: 0.875rem;
    }
    
    .breadcrumb-item {
        display: flex;
        align-items: center;
    }
    
    .breadcrumb-item + .breadcrumb-item::before {
        content: '>';
        margin: 0 0.75rem;
        color: #9ca3af; 
    }
    
    .breadcrumbs a {
        color: #4b5563; 
        text-decoration: none;
        transition: color 0.2s ease-in-out;
    }
    
    .breadcrumbs a:hover {
        color: #111827; 
        text-decoration: underline;
    }
    
    .breadcrumb-item span {
        color: #1f2937; 
        font-weight: 500;
    }
    </style>
    
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumbs">
        <% breadcrumbs.forEach(function(crumb) { %>
          <li class="breadcrumb-item">
            <% if (crumb.active) { %>
                               <span aria-current="page"><%= crumb.name %></span>
                           <% } else { %>
                               <a href="<%= crumb.link %>"><%= crumb.name %></a>
                               <% } %>
                              </li>
                              <% }); %>
                            </ol>
                          </nav>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
        <div class="flex flex-col md:flex-row gap-8">

    <aside class="account-sidebar">
        <div class="account-sidebar-card">
            <h2 class="sidebar-title">My Account</h2>
            <nav class="sidebar-nav">
                <a href="/account" class="nav-link">
                    <span class="material-symbols-outlined">person</span>
                    <span>Personal Information</span>
                </a>
                <a href="/account/address" class="nav-link">
                    <span class="material-symbols-outlined">home</span>
                    <span>Address</span>
                </a>
                <a href="/account/orders" class="nav-link active">
                    <span class="material-symbols-outlined">receipt_long</span>
                    <span>Order</span>
                </a>
                <a href="/account/wallet" class="nav-link">
                    <span class="material-symbols-outlined">account_balance_wallet</span>
                    <span>Wallet</span>
                </a>
                <a href="/account/coupons" class="nav-link">
                    <span class="material-symbols-outlined">local_offer</span>
                    <span>Coupon</span>
                </a>
                <a href="/account/change-password" class="nav-link">
                    <span class="material-symbols-outlined">lock</span>
                    <span>Password Change</span>
                </a>
                <form action="/logout" method="POST" style="margin:0; padding:0;">
                    <button class="nav-link">
                        <span class="material-symbols-outlined">logout</span>
                        <span>Logout</span>
                    </button>
                </form>
            </nav>
        </div>
    </aside>

            <main class="w-full md:w-3/4">
                <div class="bg-white p-6 md:p-8 border border-gray-200 rounded-lg shadow-sm">
                    <div class="flex flex-col sm:flex-row justify-between sm:items-center pb-4 mb-6 border-b">
                        <h1 class="text-2xl font-bold text-gray-800 mb-4 sm:mb-0">My Orders</h1>
                        <div class="relative w-full sm:max-w-xs">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                                </svg>
                            </span>
                            <input
                                type="search"
                                placeholder="Search by product or Order ID"
                                class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-800 transition">
                        </div>
                    </div>

                    <div class="space-y-6" id="ordersContainer">
                        
                        <% if (orderData.length === 0) { %>
                            <p class="text-center text-gray-500 py-10">No orders found.</p>
                        <% } else { %>
                            <% orderData.forEach(order => { %>
                                <% 
                                    let statusColor = "bg-gray-400";
                                    let statusTextColor = "text-gray-800";
                                    if (order.status === "Pending") { statusColor = "bg-yellow-400"; statusTextColor = "text-yellow-800"; }
                                    if (order.status === "Shipped") { statusColor = "bg-blue-400"; statusTextColor = "text-blue-800"; }
                                    if (order.status === "Delivered") { statusColor = "bg-green-400"; statusTextColor = "text-green-800"; }
                                    if (order.status === "Cancelled") { statusColor = "bg-red-400"; statusTextColor = "text-red-800"; }
                                
                                    const orderDate = new Date(order.order_date).toLocaleDateString('en-IN', {
                                        day: '2-digit',
                                        month: 'short',
                                        year: 'numeric'
                                    });
                                %>
                                <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-4 sm:p-6 transition hover:shadow-md">
                                    <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6">
                                        <div class="w-full h-32 sm:w-28 sm:h-28 flex-shrink-0 bg-gray-100 rounded-md flex items-center justify-center">
                                          <img src="<%=order.items[0].product_id.variants[order.items[0].variant].image_url[0]%>" width="150px" height="150px" alt="">
                                        </div>
    
                                        <div class="flex-grow flex flex-col justify-between w-full">
                                            <div>
                                                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-2">
                                                    <div>
                                                        <p class="text-sm text-gray-500">Order ID</p>
                                                        <h3 class="font-bold text-lg text-gray-900">#<%= order.order_id %></h3>
                                                    </div>
                                                    <p class="text-sm text-gray-500 mt-2 sm:mt-0 sm:self-start">
                                                        <%= orderDate %>
                                                    </p>
                                                </div>
                                                
                                                <div class="mt-3">
                                                    <h4 class="font-semibold text-gray-900 truncate" title="<%= order.items[0]?.name || 'Product' %>">
                                                        <%= order.items[0].product_id.name || 'Product' %>
                                                    </h4>
                                                    <% if (order.items.length > 1) { %>
                                                        <p class="text-xs text-gray-500 mt-1">+ <%= order.items.length - 1 %> more item(s)</p>
                                                    <% } %>
                                                    
                                                    <div class="flex justify-between items-center mt-3">
                                                        <span class="text-gray-600 font-medium">Total Amount</span>
                                                        <span class="font-bold text-lg text-gray-900">₹ <%= order.subtotal.toLocaleString('en-IN') %></span>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="mt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                                                <div class="flex items-center gap-2 px-3 py-1 rounded-full <%= statusColor %> <%= statusTextColor %> bg-opacity-20 self-start">
                                                    <span class="w-2.5 h-2.5 rounded-full <%= statusColor %>"></span>
                                                    <p class="font-bold text-sm"><%= order.status %></p>
                                                </div>
                                                <button 
                                                    class="text-sm w-full sm:w-auto font-bold bg-gray-900 text-white px-5 py-2.5 rounded-lg hover:bg-gray-700 transition duration-300 shadow-sm"
                                                    onclick="window.location.href='/order-details/<%= order._id %>'">
                                                    View Details
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                        
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.querySelector('input[type="search"]');
        const ordersContainer = document.getElementById('ordersContainer');
        
        let debounceTimer;
        const debounceFetch = (callback, delay = 300) => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(callback, delay);
        };

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.trim();

            debounceFetch(async () => {
                try {
                    const res = await fetch(`/account/orders/search?query=${encodeURIComponent(query)}`);
                    if (!res.ok) throw new Error('Search request failed');
                    
                    const data = await res.json();
                    
                    ordersContainer.innerHTML = ''; 

                    if (data.length === 0) {
                        ordersContainer.innerHTML = `<p class="text-center text-gray-500 py-10">No orders found.</p>`;
                        return;
                    }

                    data.forEach(order => {
                        let statusColor = "bg-gray-400";
                        let statusTextColor = "text-gray-800";
                        if (order.status === "Pending") { statusColor = "bg-yellow-400"; statusTextColor = "text-yellow-800"; }
                        if (order.status === "Shipped") { statusColor = "bg-blue-400"; statusTextColor = "text-blue-800"; }
                        if (order.status === "Delivered") { statusColor = "bg-green-400"; statusTextColor = "text-green-800"; }
                        if (order.status === "Cancelled") { statusColor = "bg-red-400"; statusTextColor = "text-red-800"; }
                        
                        const orderDate = new Date(order.order_date).toLocaleDateString('en-IN', {
                            day: '2-digit',
                            month: 'short',
                            year: 'numeric'
                        })

                
                        const product = order.items[0]?.product_id;
                        const variantIndex = order.items[0]?.variant;
                        const image_url = product?.variants?.[variantIndex]?.image_url?.[0] || '/default-image.jpg'; // Add a fallback image

                        const productName = product?.name || 'Product'; 

                        const moreItemsHTML = order.items.length > 1 ? `<p class="text-xs text-gray-500 mt-1">+ ${order.items.length - 1} more item(s)</p>` : '';

                        const orderCardHTML = `
                        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-4 sm:p-6 transition hover:shadow-md">
                            <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6">
                                <div class="w-full h-32 sm:w-28 sm:h-28 flex-shrink-0 bg-gray-100 rounded-md flex items-center justify-center">
                                    <img src="${image_url}" alt="${productName}" class="w-full h-full object-contain"> </div>
                                <div class="flex-grow flex flex-col justify-between w-full">
                                    <div>
                                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-2">
                                            <div>
                                                <p class="text-sm text-gray-500">Order ID</p>
                                                <h3 class="font-bold text-lg text-gray-900">#${order.order_id}</h3>
                                            </div>
                                            <p class="text-sm text-gray-500 mt-2 sm:mt-0 sm:self-start">
                                                ${orderDate}
                                            </p>
                                        </div>
                                        <div class="mt-3">
                                            <h4 class="font-semibold text-gray-900 truncate" title="${productName}">${productName}</h4>
                                            ${moreItemsHTML}
                                            <div class="flex justify-between items-center mt-3">
                                                <span class="text-gray-600 font-medium">Total Amount</span>
                                                <span class="font-bold text-lg text-gray-900">₹ ${order.subtotal.toLocaleString('en-IN')}</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                                        <div class="flex items-center gap-2 px-3 py-1 rounded-full ${statusColor} ${statusTextColor} bg-opacity-20 self-start">
                                            <span class="w-2.5 h-2.5 rounded-full ${statusColor}"></span>
                                            <p class="font-bold text-sm">${order.status}</p>
                                        </div>
                                        <button 
                                            class="text-sm w-full sm:w-auto font-bold bg-gray-900 text-white px-5 py-2.5 rounded-lg hover:bg-gray-700 transition duration-300 shadow-sm"
                                            onclick="window.location.href='/order-details/${order._id}'">
                                            View Details
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        `;
                        ordersContainer.insertAdjacentHTML('beforeend', orderCardHTML);
                    });

                } catch (err) {
                    console.error('Search failed:', err);
                    ordersContainer.innerHTML = `<p class="text-center text-red-500 py-10">Failed to load search results.</p>`;
                }
            });
        });
    });
</script>
