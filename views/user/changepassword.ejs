<link rel="stylesheet" href="/css/user/forgotPassword.css">

<main class="main-content">
    <div class="form-container">
        <h2>Enter your current Password</h2>
        <form id="forgotForm">
            <div class="input-group">
                <input type="password" id="password" name="password" placeholder="Password" required>
            </div>
            <button type="submit" class="submit-btn">submit</button>
        </form>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const submitbtn = document.querySelector('.submit-btn')
  const passwordInput = document.getElementById('password')

  submitbtn.addEventListener('click', async (e) => {
    e.preventDefault()
    const password = passwordInput.value
    try {
      const response = await fetch('/account/changePassVerify', {
        method: 'POST',
        body: JSON.stringify({ userpass: password }),
        headers: { 'Content-Type': 'application/json' }
      })

      const res = await response.json()

      if (response.ok) {
        window.location.href = '/account/newPassword'
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Verification Failed',
          text: res.message || 'Invalid password. Please try again.'
        })
      }
    } catch (error) {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Something went wrong. Please try again later.'
      })
    }
  })
</script>
